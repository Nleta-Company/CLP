generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USER MANAGEMENT
// ==========================================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clientProfile       ClientProfile?
  timeline            RequestTimeline[]    @relation("TimelineActor")
  requests            ServiceRequest[]     @relation("ClientRequests")
  finalTrainingOffers FinalTrainingOffer[] @relation("FTOCreatedBy")

  submittedPayments PaymentSubmission[] @relation("PaymentSubmitter")
  reviewedPayments  PaymentSubmission[] @relation("PaymentReviewer")

  generatedPtaAgreements PtaAgreement[] @relation("PTAGeneratedBy")
  generatedTafAgreements TafAgreement[] @relation("TAFGeneratedBy")

  trainerAssignments        TrainerAssignment[] @relation("AssignedTrainer")
  createdTrainerAssignments TrainerAssignment[] @relation("TrainerAssignmentCreator")

  createdBatches Batch[] @relation("BatchCreator")

  markedAttendance AttendanceRecord[] @relation("AttendanceMarker")

  // ATR-01 relations
  createdAtrReports  AtrReport[] @relation("AtrReportCreator")
  reviewedAtrReports AtrReport[] @relation("AtrReportReviewer")
}

// ==========================================
// CLIENT PROFILE
// ==========================================

model ClientProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  organisation String
  gstin        String?
  address      String
  country      String   @default("India")
  state        String
  city         String
  contactName  String
  designation  String?
  phone        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// TRAINING PROGRAMS
// ==========================================

model TrainingProgram {
  id        String           @id @default(cuid())
  code      String           @unique
  title     String
  category  TrainingCategory
  audience  String
  mode      DeliveryMode
  duration  String
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  requestPrograms RequestProgram[]
}

// ==========================================
// SERVICE REQUEST
// ==========================================

model ServiceRequest {
  id                     String        @id @default(cuid())
  requestNumber          String        @unique
  clientId               String
  status                 RequestStatus @default(DRAFT)
  preferredDate          DateTime?
  alternateDate          DateTime?
  trainingLocation       String
  preferredLanguage      String?
  coordinator            String?
  facilities             String?
  assessment             String?
  refresher              String?
  additionalRequirements String?
  submittedAt            DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  billingAddress String?
  city           String?
  contactName    String?
  country        String?
  designation    String?
  email          String?
  gstin          String?
  organisation   String?
  phone          String?
  state          String?

  clientDecisionAt      DateTime?
  clientRejectionReason String?   @db.Text
  clientRespondedById   String?

  programs RequestProgram[]
  timeline RequestTimeline[]

  client             User                @relation("ClientRequests", fields: [clientId], references: [id])
  finalTrainingOffer FinalTrainingOffer?

  ptaAgreement PtaAgreement?
  tafAgreement TafAgreement?

  trainerAssignmentMode TrainerAssignmentMode?
  trainerAssignments    TrainerAssignment[]
}

// ==========================================
// REQUEST PROGRAMS
// ==========================================

model RequestProgram {
  id                String       @id @default(cuid())
  requestId         String
  trainingProgramId String
  participants      Int
  expectedBatches   Int
  preferredMode     DeliveryMode
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  request ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  program TrainingProgram @relation(fields: [trainingProgramId], references: [id])

  trainerAssignments TrainerAssignment[]
  batches            Batch[]

  // ATR-01 relation
  atrReports AtrReport[]

  @@unique([requestId, trainingProgramId])
}

// ==========================================
// REQUEST TIMELINE
// ==========================================

model RequestTimeline {
  id        String        @id @default(cuid())
  requestId String
  actorId   String?
  status    RequestStatus
  remarks   String?
  createdAt DateTime      @default(now())

  actor   User?          @relation("TimelineActor", fields: [actorId], references: [id])
  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

// ==========================================
// FINAL TRAINING OFFER (FTO)
// ==========================================

model FinalTrainingOffer {
  id        String @id @default(cuid())
  ftoNumber String @unique
  requestId String @unique

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  currency         String  @default("INR")
  subtotal         Decimal @default(0) @db.Decimal(12, 2)
  discountPercent  Decimal @default(0) @db.Decimal(5, 2)
  discountAmount   Decimal @default(0) @db.Decimal(12, 2)
  logisticsCharges Decimal @default(0) @db.Decimal(12, 2)
  otherCharges     Decimal @default(0) @db.Decimal(12, 2)
  taxableAmount    Decimal @default(0) @db.Decimal(12, 2)
  gstPercent       Decimal @default(18) @db.Decimal(5, 2)
  gstAmount        Decimal @default(0) @db.Decimal(12, 2)
  grandTotal       Decimal @default(0) @db.Decimal(12, 2)

  issueDate      DateTime  @default(now())
  validUntil     DateTime?
  jurisdiction   String?
  terms          String?
  specialRemarks String?
  documentUrl    String?

  clientPoNumber            String?
  confirmedTrainingSchedule String? @db.Text
  dailyTrainingTiming       String?
  paymentMilestones         String? @db.Text
  logisticsTreatment        String? @db.Text

  paymentTerm PaymentTerm?

  createdById String
  createdBy   User   @relation("FTOCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs            FTOProgram[]
  paymentInstallments PaymentInstallment[]
}

// ==========================================
// FTO PROGRAMS
// ==========================================

model FTOProgram {
  id    String             @id @default(cuid())
  ftoId String
  fto   FinalTrainingOffer @relation(fields: [ftoId], references: [id], onDelete: Cascade)

  programCode   String
  programTitle  String
  duration      String
  deliveryMode  DeliveryMode
  participants  Int
  batches       Int
  pricePerBatch Decimal      @db.Decimal(12, 2)
  totalAmount   Decimal      @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ftoId])
}

// ==========================================
// PAYMENT MANAGEMENT
// ==========================================

model PaymentInstallment {
  id    String             @id @default(cuid())
  ftoId String
  fto   FinalTrainingOffer @relation(fields: [ftoId], references: [id], onDelete: Cascade)

  installmentNumber Int
  percentage        Decimal          @db.Decimal(5, 2)
  amount            Decimal          @db.Decimal(12, 2)
  milestone         PaymentMilestone

  status PaymentInstallmentStatus @default(PENDING)

  submissions PaymentSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ftoId, installmentNumber])
  @@index([ftoId, status])
}

model PaymentSubmission {
  id            String             @id @default(cuid())
  installmentId String
  installment   PaymentInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  submittedById String
  submittedBy   User   @relation("PaymentSubmitter", fields: [submittedById], references: [id])

  paymentMethod        String?
  transactionReference String?
  proofUrl             String
  amountPaid           Decimal @db.Decimal(12, 2)

  status       PaymentSubmissionStatus @default(PENDING)
  adminRemarks String?                 @db.Text

  reviewedById String?
  reviewedBy   User?     @relation("PaymentReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([installmentId, status])
  @@index([submittedById])
  @@index([reviewedById])
}

// ==========================================
// PTA AGREEMENT MANAGEMENT
// ==========================================

model PtaAgreement {
  id        String @id @default(cuid())
  ptaNumber String @unique

  requestId String         @unique
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  documentUrl   String?   @db.Text
  effectiveDate DateTime?

  status PtaStatus @default(GENERATED)

  generatedById String
  generatedBy   User   @relation("PTAGeneratedBy", fields: [generatedById], references: [id])

  clientDecisionAt      DateTime?
  clientRejectionReason String?   @db.Text
  clientRespondedById   String?

  generatedAt DateTime  @default(now())
  sentAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ==========================================
// TAF AGREEMENT MANAGEMENT
// ==========================================

model TafAgreement {
  id        String @id @default(cuid())
  tafNumber String @unique

  requestId String         @unique
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  documentUrl String? @db.Text

  status TafStatus @default(GENERATED)

  generatedById String
  generatedBy   User   @relation("TAFGeneratedBy", fields: [generatedById], references: [id])

  clientDecisionAt      DateTime?
  clientRejectionReason String?   @db.Text
  clientRespondedById   String?

  generatedAt DateTime  @default(now())
  sentAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ==========================================
// TRAINER ASSIGNMENT MANAGEMENT
// ==========================================

model TrainerAssignment {
  id String @id @default(cuid())

  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  requestProgramId String?
  requestProgram   RequestProgram? @relation(fields: [requestProgramId], references: [id], onDelete: Cascade)

  trainerId String
  trainer   User   @relation("AssignedTrainer", fields: [trainerId], references: [id])

  batchNumber Int?

  status TrainerAssignmentStatus @default(ASSIGNED)

  assignedById String
  assignedBy   User   @relation("TrainerAssignmentCreator", fields: [assignedById], references: [id])

  assignedAt DateTime @default(now())
  remarks    String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches Batch[]

  // ATR-01 relation
  atrReports AtrReport[]

  @@index([requestId])
  @@index([trainerId])
  @@index([requestProgramId])
  @@index([assignedById])
  @@index([requestId, status])
}

// ==========================================
// BATCH MANAGEMENT
// ==========================================

model Batch {
  id String @id @default(cuid())

  requestProgramId String
  requestProgram   RequestProgram @relation(fields: [requestProgramId], references: [id], onDelete: Cascade)

  trainerAssignmentId String?
  trainerAssignment   TrainerAssignment? @relation(fields: [trainerAssignmentId], references: [id], onDelete: SetNull)

  batchNumber  Int
  participants Int

  startDate DateTime?
  endDate   DateTime?
  mode      DeliveryMode
  location  String?

  status BatchStatus @default(PLANNED)

  createdById String
  createdBy   User   @relation("BatchCreator", fields: [createdById], references: [id])

  participantsList BatchParticipant[]

  // ATR-01 relation
  atrReports AtrReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestProgramId, batchNumber])
  @@index([trainerAssignmentId])
  @@index([status])
}

// ==========================================
// BATCH PARTICIPANTS
// ==========================================

model BatchParticipant {
  id      String @id @default(cuid())
  batchId String

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  name       String
  email      String?
  phone      String?
  employeeId String?

  attendanceRecords AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId])
  @@index([email])
}

// ==========================================
// ATTENDANCE MANAGEMENT
// ==========================================

model AttendanceRecord {
  id            String @id @default(cuid())
  participantId String

  participant BatchParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  attendanceDate DateTime
  status         AttendanceStatus
  remarks        String?          @db.Text

  markedById String
  markedBy   User   @relation("AttendanceMarker", fields: [markedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([participantId, attendanceDate])
  @@index([attendanceDate])
  @@index([markedById])
}

// ==========================================
// ATR-01 ASSESSMENT & TRAINING RESULT REPORT
// ==========================================

model AtrReport {
  id String @id @default(cuid())

  reportNumber String @unique
  revision     String @default("Rev.2")

  trainerAssignmentId String
  trainerAssignment   TrainerAssignment @relation(fields: [trainerAssignmentId], references: [id], onDelete: Cascade)

  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  requestProgramId String?
  requestProgram   RequestProgram? @relation(fields: [requestProgramId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("AtrReportCreator", fields: [createdById], references: [id])

  reviewedById String?
  reviewedBy   User?   @relation("AtrReportReviewer", fields: [reviewedById], references: [id])

  status            AtrReportStatus       @default(DRAFT)
  finalResultStatus AtrFinalResultStatus?

  // Section 2: Client, Engagement and Batch References

  clientLegalEntity       String?
  clientContactDepartment String? @db.Text

  ptaReference String?
  ptaDate      DateTime?

  ftfReference      String?
  ftfRevision       String?
  ftfAcceptanceDate DateTime?

  tafReference      String?
  tafActivationDate DateTime?

  tspReference String?

  programmeSpecification String?
  programmeRevision      String?

  deliveryMode      DeliveryMode?
  trainingStartDate DateTime?
  trainingEndDate   DateTime?
  actualDuration    String?
  venueOrPlatform   String?

  trainerName             String?
  trainerRole             String?
  trainerQualificationRef String?

  registeredParticipants Int?

  // Section 3: Training Delivery Summary

  trainingDelivery   Json?
  deliveryDeviations Json?

  // Section 4: Attendance Summary

  tarReference String?

  participantsAttended           Int?
  participantsMeetingRequirement Int?

  attendanceNotes             String? @db.Text
  attendanceRequirementSource String? @db.Text

  // Section 5: Assessment Method and Approved Criteria

  assessmentCriteria Json?

  // Section 6: Participant-Level Result Register

  participantResults Json?

  // Section 7: Cohort Result Summary

  cohortSummary Json?

  // Section 8: Trainer / Assessor Observations and Follow-up

  trainerObservations Json?

  // Section 9: Result Review and Approval

  reviewedAt       DateTime?
  reviewNotes      String?   @db.Text
  approvalEvidence String?   @db.Text

  preparedByName String?
  preparedByRole String?

  // Section 10: Linked Deliverables and Closure Handover

  linkedDeliverables Json?

  clientHandoverRef  String?
  clientHandoverDate DateTime?

  // Section 11: Record Handling and Document Control

  issuedAt       DateTime?
  documentUrl    String?   @db.Text
  correctionNote String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trainerAssignmentId, status])
  @@index([batchId])
  @@index([requestProgramId])
  @@index([createdById])
  @@index([reviewedById])
  @@index([reportNumber])
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  ADMIN
  SUB_ADMIN
  CLIENT
  BDE
  TRAINER
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REQUEST_ACCEPTED
  REQUEST_REJECTED

  TSO_DRAFT
  TSO_SENT
  TSO_ACCEPTED
  TSO_REJECTED

  FTO_DRAFT
  FTO_SENT
  FTO_ACCEPTED
  FTO_REJECTED

  PAYMENT_PENDING
  PAYMENT_SUBMITTED
  PAYMENT_VERIFICATION
  PAYMENT_VERIFIED

  PTA_SENT
  PTA_ACCEPTED
  PTA_REJECTED

  PSGA_DRAFT
  PSGA_SENT
  PSGA_ACCEPTED
  PSGA_REJECTED

  TAF_DRAFT
  TAF_SENT
  TAF_ACCEPTED
  TAF_REJECTED

  TRAINER_ASSIGNMENT
  TRAINING
  COMPLETED
  CANCELLED
}

enum TrainingCategory {
  WCT
  SCT
  OET
  LET
  FMT
  CSR
  PDT
  ADT
  TTM
}

enum DeliveryMode {
  ON
  HY
  OF
}

enum PaymentTerm {
  FULL
  HALF_HALF
  HALF_QUARTER_QUARTER
}

enum PaymentMilestone {
  FTO_ACCEPTANCE
  BEFORE_TRAINING
  BEFORE_FINAL_BATCH
}

enum PaymentInstallmentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum PaymentSubmissionStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PtaStatus {
  GENERATED
  SENT
  ACCEPTED
  REJECTED
}

enum TafStatus {
  GENERATED
  SENT
  ACCEPTED
  REJECTED
}

enum TrainerAssignmentMode {
  SINGLE
  MULTIPLE
}

enum TrainerAssignmentStatus {
  ASSIGNED
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

enum BatchStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

// ==========================================
// ATR-01 REPORT STATUS
// ==========================================

enum AtrReportStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  RETURNED_FOR_CORRECTION
  APPROVED
  CANCELLED
}

// ==========================================
// ATR-01 FINAL RESULT STATUS
// ==========================================

enum AtrFinalResultStatus {
  APPROVED
  PENDING_EVIDENCE_CRITERIA
  RETURNED_FOR_CORRECTION
}
